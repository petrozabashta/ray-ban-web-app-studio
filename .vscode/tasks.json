{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запуск разработки",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Production build",
      "type": "npm",
      "script": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Production preview",
      "type": "npm",
      "script": "preview",
      "dependsOn": "Production build",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "TypeScript typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "ESLint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": []
    },
    {
      "label": "Unit tests",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    },
    {
      "label": "Production browser tests",
      "type": "npm",
      "script": "test:browser",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Полная локальная проверка",
      "type": "npm",
      "script": "check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
